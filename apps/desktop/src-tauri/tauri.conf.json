{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STARPLAYER",
  "version": "0.2.1",
  "identifier": "com.grecia.starplayer",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STARPLAYER",
        "width": 480,
        "height": 780,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
